HTML_Dashboard = 
VAR _Hoje = TODAY()
VAR _DataRef = FORMAT(_Hoje, "DD/MM/YYYY")

-- =====================================================
-- BASE DINÂMICA
-- Mantém os filtros aplicados pelo Power BI
-- e trabalha somente com contas em aberto.
-- =====================================================
VAR _Base =
    SELECTCOLUMNS(
        CALCULATETABLE(
            'Contas a pagar',
            KEEPFILTERS(
                'Contas a pagar'[Situacao] = "Em aberto"
            ),
            KEEPFILTERS(
                NOT ISBLANK('Contas a pagar'[Vencimento])
            )
        ),

        "Forn",
            SUBSTITUTE(
                SUBSTITUTE(
                    SUBSTITUTE(
                        SUBSTITUTE(
                            'Contas a pagar'[Fornecedor],
                            "&", "&amp;"
                        ),
                        "<", "&lt;"
                    ),
                    ">", "&gt;"
                ),
                "'", "&#39;"
            ),

        "Hist",
            SUBSTITUTE(
                SUBSTITUTE(
                    SUBSTITUTE(
                        SUBSTITUTE(
                            LEFT(
                                'Contas a pagar'[Histórico],
                                60
                            ),
                            "&", "&amp;"
                        ),
                        "<", "&lt;"
                    ),
                    ">", "&gt;"
                ),
                "'", "&#39;"
            ),

        "Venc",
            'Contas a pagar'[Vencimento],

        "Valor",
            'Contas a pagar'[Valor (R$)],

        "Dias",
            DATEDIFF(
                'Contas a pagar'[Vencimento],
                _Hoje,
                DAY
            ),

        "Chave",
            FORMAT(
                'Contas a pagar'[Vencimento],
                "YYYY-MM"
            )
    )

-- =====================================================
-- CLASSIFICAÇÃO
-- =====================================================
VAR _Atr =
    FILTER(
        _Base,
        [Dias] > 0
    )

VAR _HojeT =
    FILTER(
        _Base,
        [Dias] = 0
    )

VAR _Prazo =
    FILTER(
        _Base,
        [Dias] < 0
    )

-- =====================================================
-- KPIs
-- =====================================================
VAR _Atrasado =
    SUMX(
        _Atr,
        [Valor]
    ) + 0

VAR _VHoje =
    SUMX(
        _HojeT,
        [Valor]
    ) + 0

VAR _Aberto =
    SUMX(
        _Prazo,
        [Valor]
    ) + 0

VAR _Total =
    _Atrasado
    + _VHoje
    + _Aberto

VAR _QtdAtr =
    COUNTROWS(_Atr) + 0

VAR _QtdHoje =
    COUNTROWS(_HojeT) + 0

VAR _QtdAberto =
    COUNTROWS(_Prazo) + 0

VAR _QtdTotal =
    COUNTROWS(_Base) + 0

-- =====================================================
-- DIAGNÓSTICO
-- =====================================================
VAR _HtmlDiag =
    IF(
        _QtdTotal = 0,

        "<div class='diag'>
            Nenhuma conta em aberto com vencimento preenchido
            foi encontrada dentro dos filtros selecionados.
        </div>",

        ""
    )

-- =====================================================
-- TOP 8 FORNECEDORES
-- =====================================================
VAR _TabForn =
    TOPN(
        8,

        GROUPBY(
            _Base,
            [Forn],
            "@v",
                SUMX(
                    CURRENTGROUP(),
                    [Valor]
                )
        ),

        [@v],
        DESC
    )

VAR _MaxForn =
    MAXX(
        _TabForn,
        [@v]
    )

VAR _HtmlForn =
    CONCATENATEX(
        _TabForn,

        "<div class='row'>

            <span class='n'
                  title='" & [Forn] & "'>
                " & [Forn] & "
            </span>

            <div class='bar'>

                <i style='
                    width:" &
                    FORMAT(
                        DIVIDE(
                            [@v],
                            _MaxForn
                        ) * 100 + 0,
                        "0.0",
                        "en-US"
                    )
                    &
                    "%;
                    background:var(--danger)
                '></i>

            </div>

            <b>
                R$ " &
                FORMAT(
                    [@v],
                    "#,##0.00",
                    "pt-BR"
                )
                &
            "</b>

        </div>",

        "",
        [@v],
        DESC
    )

-- =====================================================
-- ATRASO POR FAIXA
-- =====================================================
VAR _Faixas =
    DATATABLE(
        "Faixa", STRING,
        "De", INTEGER,
        "Ate", INTEGER,
        {
            {"1–30 dias", 1, 30},
            {"31–60 dias", 31, 60},
            {"61–90 dias", 61, 90},
            {"91–180 dias", 91, 180},
            {"Mais de 180", 181, 99999}
        }
    )

VAR _FaixasVal =
    ADDCOLUMNS(
        _Faixas,

        "@v",
            VAR a = [De]
            VAR b = [Ate]

            RETURN
                SUMX(
                    FILTER(
                        _Atr,
                        [Dias] >= a
                            &&
                        [Dias] <= b
                    ),
                    [Valor]
                ) + 0
    )

VAR _MaxFaixa =
    MAXX(
        _FaixasVal,
        [@v]
    )

VAR _HtmlFaixa =
    CONCATENATEX(
        _FaixasVal,

        "<div class='row'>

            <span class='n'>
                " & [Faixa] & "
            </span>

            <div class='bar'>

                <i style='
                    width:" &
                    FORMAT(
                        DIVIDE(
                            [@v],
                            _MaxFaixa
                        ) * 100 + 0,
                        "0.0",
                        "en-US"
                    )
                    &
                    "%;
                    background:var(--warn)
                '></i>

            </div>

            <b>
                R$ " &
                FORMAT(
                    [@v],
                    "#,##0.00",
                    "pt-BR"
                )
                &
            "</b>

        </div>",

        "",
        [De],
        ASC
    )

-- =====================================================
-- VENCIMENTOS POR MÊS
-- =====================================================
VAR _Meses =
    GROUPBY(
        _Base,
        [Chave],
        "@v",
            SUMX(
                CURRENTGROUP(),
                [Valor]
            )
    )

VAR _MaxMes =
    MAXX(
        _Meses,
        [@v]
    )

VAR _HtmlMes =
    CONCATENATEX(
        _Meses,

        "<div class='col'
              title='R$ " &
              FORMAT(
                  [@v],
                  "#,##0.00",
                  "pt-BR"
              )
              &
              "'>

            <span class='v'>
                " &
                FORMAT(
                    DIVIDE(
                        [@v],
                        1000
                    ),
                    "#,##0",
                    "pt-BR"
                )
                &
                "k
            </span>

            <div class='bw'>

                <i style='
                    height:" &
                    FORMAT(
                        DIVIDE(
                            [@v],
                            _MaxMes
                        ) * 100 + 0,
                        "0.0",
                        "en-US"
                    )
                    &
                    "%;
                '></i>

            </div>

            <span class='l'>
                " &
                FORMAT(
                    DATE(
                        VALUE(
                            LEFT(
                                [Chave],
                                4
                            )
                        ),
                        VALUE(
                            RIGHT(
                                [Chave],
                                2
                            )
                        ),
                        1
                    ),
                    "MM/yyyy"
                )
                &
            "</span>

        </div>",

        "",
        [Chave],
        ASC
    )

-- =====================================================
-- =====================================================
-- CONTAS EM ATRASO
-- SEM LIMITE
-- =====================================================
VAR _TabUrg =
    _Atr

VAR _HtmlUrg =
    CONCATENATEX(
        _TabUrg,

        "<tr>

            <td>
                " & [Forn] & "
            </td>

            <td>
                " &
                FORMAT(
                    [Venc],
                    "DD/MM/YYYY"
                )
                &
            "</td>

            <td class='r'>
                " &
                [Dias]
                &
            "</td>

            <td class='r'>
                R$ " &
                FORMAT(
                    [Valor],
                    "#,##0.00",
                    "pt-BR"
                )
                &
            "</td>

        </tr>",

        "",
        [Dias],
        DESC
    )

-- =====================================================
-- PRÓXIMOS VENCIMENTOS
-- Hoje + futuros
-- =====================================================
VAR _TabProx =
    TOPN(
        12,

        FILTER(
            _Base,
            [Dias] <= 0
        ),

        [Venc],
        ASC
    )

VAR _HtmlProx =
    CONCATENATEX(
        _TabProx,

        "<tr>

            <td>
                " & [Forn] & "
            </td>

            <td>
                " & [Hist] & "
            </td>

            <td>
                " &
                FORMAT(
                    [Venc],
                    "DD/MM/YYYY"
                )
                &
            "</td>

            <td class='r'>
                R$ " &
                FORMAT(
                    [Valor],
                    "#,##0.00",
                    "pt-BR"
                )
                &
            "</td>

        </tr>",

        "",
        [Venc],
        ASC,
        [Valor],
        DESC
    )

-- =====================================================
-- HTML FINAL
-- =====================================================
RETURN

"
<!DOCTYPE html>

<html lang='pt-BR'>

<head>

<meta charset='UTF-8'>

<meta name='viewport'
      content='width=device-width, initial-scale=1'>

<title>Dashboard · Contas a Pagar</title>

<style>

:root {

    --bg:#f1f5f9;
    --card:#ffffff;
    --text:#0f172a;
    --muted:#64748b;
    --border:#e2e8f0;
    --primary:#3b82f6;
    --danger:#ef4444;
    --success:#10b981;
    --warn:#d68910;
    --slate:#34495e;

}

* {
    box-sizing:border-box;
}

html {
    font-size:clamp(13px, 1.25vw, 22px);
}

body {

    margin:0;
    padding:1rem;

    background:var(--bg);
    color:var(--text);

    font-family:'Segoe UI',
                system-ui,
                sans-serif;

    font-size:1rem;
    line-height:1.35;

}

.header {

    display:flex;
    justify-content:space-between;
    align-items:center;

    flex-wrap:wrap;

    gap:.5rem;

    margin-bottom:1rem;
    padding-bottom:.7rem;

    border-bottom:2px solid var(--border);

}

.header h1 {

    font-size:1.5rem;
    margin:0;

    color:#1e293b;

    font-weight:700;

}

.header span {

    font-size:.85rem;

    color:var(--muted);

    background:#e2e8f0;

    padding:.3rem .7rem;

    border-radius:.5rem;

}

.diag {

    background:#fef3c7;

    border:1px solid #f59e0b;

    color:#78350f;

    padding:.7rem 1rem;

    border-radius:.6rem;

    margin-bottom:1rem;

    font-size:.9rem;

}

.kpi-grid {

    display:grid;

    grid-template-columns:
        repeat(4,1fr);

    gap:1rem;

    margin-bottom:1rem;

}

.kpi-card {

    background:var(--card);

    border:1px solid var(--border);

    border-radius:.7rem;

    padding:1rem 1.1rem;

    position:relative;

    overflow:hidden;

    box-shadow:
        0 1px 3px rgba(0,0,0,.06);

}

.kpi-card::before {

    content:'';

    position:absolute;

    top:0;
    left:0;

    width:.3rem;
    height:100%;

    background:
        var(--accent,var(--primary));

}

.kpi-card small {

    color:var(--muted);

    font-size:.75rem;

    font-weight:700;

    text-transform:uppercase;

    letter-spacing:.05em;

    display:block;

}

.kpi-card .value {

    font-size:1.9rem;

    font-weight:700;

    margin:.3rem 0 .1rem 0;

    color:#0f172a;

    white-space:nowrap;

}

.kpi-card .qtd {

    font-size:.85rem;

    color:var(--muted);

}

.grid2 {

    display:grid;

    grid-template-columns:
        1fr 1fr;

    gap:1rem;

    margin-bottom:1rem;

}

.card {

    background:var(--card);

    border:1px solid var(--border);

    border-radius:.7rem;

    padding:1rem 1.1rem;

    min-width:0;

    box-shadow:
        0 1px 3px rgba(0,0,0,.06);

}

.card h2 {

    font-size:1.05rem;

    margin:0 0 .8rem 0;

    color:#1e293b;

}

.row {

    display:grid;

    grid-template-columns:
        minmax(8rem,38%)
        1fr
        auto;

    gap:.7rem;

    align-items:center;

    margin:.55rem 0;

    font-size:.95rem;

}

.row .n {

    overflow:hidden;

    text-overflow:ellipsis;

    white-space:nowrap;

}

.row b {

    white-space:nowrap;

}

.bar {

    height:1.2rem;

    background:var(--border);

    border-radius:.3rem;

    overflow:hidden;

}

.bar i {

    display:block;

    height:100%;

}

.cols {

    display:flex;

    align-items:stretch;

    gap:.5rem;

    height:13rem;

    overflow-x:auto;

}

.col {

    flex:1;

    min-width:3.2rem;

    display:flex;

    flex-direction:column;

    align-items:center;

    height:100%;

    font-size:.75rem;

    color:var(--muted);

}

.col .v {

    font-weight:600;

    color:var(--text);

    margin-bottom:.2rem;

}

.col .bw {

    flex:1;

    width:100%;

    display:flex;

    align-items:flex-end;

}

.col .bw i {

    width:100%;

    background:var(--primary);

    border-radius:
        .3rem .3rem 0 0;

    display:block;

}

.col .l {

    margin-top:.3rem;

}

.tb {

    overflow-x:auto;
    overflow-y:auto;

    max-height:300px;

}

table {

    width:100%;

    border-collapse:collapse;

    font-size:.9rem;

}

th,
td {

    text-align:left;

    padding:.45rem .6rem;

    border-bottom:
        1px solid var(--border);

    white-space:nowrap;

}

th {

    color:var(--muted);

    font-weight:700;

    font-size:.8rem;

    text-transform:uppercase;

    letter-spacing:.03em;

}

td.r,
th.r {

    text-align:right;

}

@media (max-width:800px) {

    .kpi-grid {

        grid-template-columns:
            repeat(2,1fr);

    }

    .grid2 {

        grid-template-columns:1fr;

    }

}

</style>

</head>

<body>

<!-- =====================================================
     CABEÇALHO
     ===================================================== -->

<div class='header'>

    <h1>
        Painel Executivo · Contas a Pagar
    </h1>

    <span>

        Referência: "
        &
        _DataRef
        &
        " · "
        &
        _QtdTotal
        &
        " contas em aberto

    </span>

</div>


" & _HtmlDiag & "


<!-- =====================================================
     KPIs
     ===================================================== -->

<div class='kpi-grid'>


    <div class='kpi-card'
         style='--accent:var(--slate);'>

        <small>
            Total a Pagar
        </small>

        <div class='value'>

            R$ "
            &
            FORMAT(
                _Total,
                "#,##0.00",
                "pt-BR"
            )
            &
            "

        </div>

        <div class='qtd'>

            "
            &
            _QtdTotal
            &
            " contas

        </div>

    </div>


    <div class='kpi-card'
         style='--accent:var(--danger);'>

        <small>
            Total Atrasado
        </small>

        <div class='value'>

            R$ "
            &
            FORMAT(
                _Atrasado,
                "#,##0.00",
                "pt-BR"
            )
            &
            "

        </div>

        <div class='qtd'>

            "
            &
            _QtdAtr
            &
            " contas

        </div>

    </div>


    <div class='kpi-card'
         style='--accent:var(--warn);'>

        <small>
            Vencem Hoje
        </small>

        <div class='value'>

            R$ "
            &
            FORMAT(
                _VHoje,
                "#,##0.00",
                "pt-BR"
            )
            &
            "

        </div>

        <div class='qtd'>

            "
            &
            _QtdHoje
            &
            " contas

        </div>

    </div>


    <div class='kpi-card'
         style='--accent:var(--primary);'>

        <small>
            Em Aberto (no prazo)
        </small>

        <div class='value'>

            R$ "
            &
            FORMAT(
                _Aberto,
                "#,##0.00",
                "pt-BR"
            )
            &
            "

        </div>

        <div class='qtd'>

            "
            &
            _QtdAberto
            &
            " contas

        </div>

    </div>


</div>


<!-- =====================================================
     FORNECEDORES + FAIXAS
     ===================================================== -->

<div class='grid2'>


    <div class='card'>

        <h2>
            Top 8 fornecedores (saldo a pagar)
        </h2>

        "
        &
        _HtmlForn
        &
        "

    </div>


    <div class='card'>

        <h2>
            Atraso por faixa de dias
        </h2>

        "
        &
        _HtmlFaixa
        &
        "

    </div>


</div>


<!-- =====================================================
     VENCIMENTOS + ATRASADAS
     ===================================================== -->

<div class='grid2'>


    <div class='card'>

        <h2>
            Vencimentos por mês
        </h2>

        <div class='cols'>

            "
            &
            _HtmlMes
            &
            "

        </div>

    </div>


    <div class='card'>

        <h2>
            Contas em atraso
        </h2>

        <div class='tb'>

            <table>

                <tr>

                    <th>
                        Fornecedor
                    </th>

                    <th>
                        Venc.
                    </th>

                    <th class='r'>
                        Dias
                    </th>

                    <th class='r'>
                        Saldo
                    </th>

                </tr>

                "
                &
                _HtmlUrg
                &
                "

            </table>

        </div>

    </div>


</div>


<!-- =====================================================
     PRÓXIMOS VENCIMENTOS
     ===================================================== -->

<div class='card'>

    <h2>
        Próximos vencimentos
    </h2>

    <div class='tb'>

        <table>

            <tr>

                <th>
                    Fornecedor
                </th>

                <th>
                    Histórico
                </th>

                <th>
                    Vencimento
                </th>

                <th class='r'>
                    Valor
                </th>

            </tr>

            "
            &
            _HtmlProx
            &
            "

        </table>

    </div>

</div>


</body>

</html>
"
